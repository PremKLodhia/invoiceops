# InvoiceOps Environment Configuration
# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoiceops
POSTGRES_USER=invoiceops
POSTGRES_PASSWORD=change_me_in_production

# Application
SPRING_PROFILES_ACTIVE=dev
APP_UPLOAD_DIR=./uploads
APP_MAX_UPLOAD_SIZE_MB=10

# Demo mode (set to true to seed demo data and enable demo credentials)
APP_DEMO_MODE=false

# Optional: Ollama AI extraction
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional: Tesseract OCR path (if not on system PATH)
# TESSERACT_PATH=/usr/bin/tesseract
